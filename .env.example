# Copy to .env and fill in. Never commit real credentials.

# Primary source
PRIMARY_DSN=postgresql://reader@primary.internal:5432/primary

# Secondary source
SECONDARY_DSN=postgresql://reader@secondary.internal:5432/secondary

# Archive source
ARCHIVE_ACCOUNT=example.region
ARCHIVE_USER=svc_reader
ARCHIVE_WAREHOUSE=READER_WH

OUTPUT_DIR=./output
LOG_LEVEL=INFO
